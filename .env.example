# Copy this file to .env.local (which is gitignored), then restart `npm run dev`.
# Backend API (FastAPI on Modal). Contract: api/CONTRACT.md on the backend-api branch.
NEXT_PUBLIC_API_URL=https://rgollapa105--clueless-closet-api-fastapi-app.us-east.modal.run

# Supabase (wardrobe, saved looks, sign-in). Schema: api/supabase_schema.sql.
# Project Settings -> API. The publishable/anon key is safe in the browser (Row Level Security).
# Leave these empty to run without sign-in: everything stays in the browser's localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI stylist chat (Stylist page). Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the
# browser. Free key: https://aistudio.google.com/apikey. GEMINI_MODEL is optional.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
